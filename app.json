{
  "expo": {
    "name": "FundenFlo",
    "slug": "fundenflo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fundenflov1app",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.diplodevsteam.fundenflo"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#082C4B",
          "image": "./assets/brand/logo-white.png",
          "imageWidth": 280
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "FundenFlo uses the camera to scan your documents (PAN, bank statement, ITR/GST) so they can be read for your Financial Health Score.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1183341a-f350-4302-9f72-a073fd199400"
      }
    },
    "owner": "diplo-devs-team"
  }
}
